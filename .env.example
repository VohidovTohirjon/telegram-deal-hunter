# ---- Sirlar (MAJBURIY) --------------------------------------------------
# @BotFather'dan olinadi
TELEGRAM_TOKEN=123456789:AAAA-your-bot-token-here
# elevenlabs.io -> Developers -> API Keys (faqat "Speech to Text: Access")
# Bo'sh qoldirilsa ovoz lokal Vosk modeli bilan tanib olinadi
ELEVENLABS_API_KEY=

# ---- Guruh va joylashuv -------------------------------------------------
# Digest yuboriladigan guruh (manfiy son). Bo'sh bo'lsa bot uni o'zi topadi.
CHAT_ID=
BOT_USERNAME=xalyavauz_bot
# /stats kabi xizmat buyruqlari uchun (vergul bilan)
ADMIN_IDS=
# Guruhga avtomatik digest yuborilsinmi (0 = yo'q)
DIGEST_TO_GROUP=0
CITY_ID=4
CITY_NAME=Toshkent

# ---- Ovoz ---------------------------------------------------------------
# elevenlabs | vosk:vosk-model-small-uz-0.22
STT_MODEL=vosk:vosk-model-small-uz-0.22

# ---- Digest -------------------------------------------------------------
TOP_N=5
SEND_HOURS=11,16,21
OLX_CATEGORIES=37
FRESH_HOURS=72
MIN_PRICE_UZS=200000
MIN_DISCOUNT_PCT=25
MAX_DISCOUNT_PCT=60
MAX_LOOKUPS_PER_RUN=120
REQUEST_DELAY_SEC=1.0

# ---- AI / ML qatlamlari -------------------------------------------------
# Narx modeli: kam peer holatida baho etaloni (o'z ma'lumotimizda o'rgatiladi)
PRICE_MODEL_ENABLED=1
# Model necha soatda bir qayta o'rgatilsin
PRICE_MODEL_MAX_AGE_H=24
# Embedding qatlami ("Shunga o'xshash" tartibi). Model fayli:
#   ./venv/bin/python -m xalyava.ml --download   (~120 MB)
EMBED_ENABLED=1
EMBED_MODEL=minilm-uz
EMBED_THREADS=2
EMBED_DUPE_THRESHOLD=0.90
# Ovoz: akustik model ishonchi shundan past bo'lsa tasdiq so'raladi (0 = hech qachon)
STT_CONFIRM_BELOW=0.62

# ---- Qidiruv ------------------------------------------------------------
PRICE_BAND_PCT=35

# ---- Kuzatuvlar (watchlist) --------------------------------------------
WATCH_INTERVAL_MIN=15
WATCH_COOLDOWN_HOURS=6
WATCH_MIN_CHANGE_PCT=5
MAX_WATCHES_PER_USER=20

# ---- Tizim --------------------------------------------------------------
DATA_DIR=/data
DB_PATH=/data/xalyava.db
LOG_LEVEL=INFO
